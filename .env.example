# Public DNS and TLS. Point DOMAIN's A/AAAA record to the VPS before starting Caddy.
DOMAIN=app.example.com
ACME_EMAIL=owner@example.com

# Owner/admin access. Use strong unique values on the VPS.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
ADMIN_ROUTE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ROUTE_TOKEN

# Keep these values stable forever once the system has active users.
# Changing them can invalidate saved sessions, Access Code hashes, or encrypted settings.
COOKIE_SECRET=REPLACE_WITH_A_LONG_RANDOM_COOKIE_SECRET
LICENSE_PEPPER=REPLACE_WITH_A_LONG_RANDOM_LICENSE_PEPPER
