# Rename this file to .gitignore only if you need it in GitHub.
# The app can run without .gitignore; it only prevents private/local files
# from being committed to the repository.

# Secrets and private configuration
.streamlit/secrets.toml
secrets.toml
.env
.env.*

# Persistent application data and local databases
licenses.db
*.db
*.sqlite
*.sqlite3

# Uploaded media and generated output
uploads/
output/
generated/
*.mp3
*.wav
*.m4a
*.mp4
*.mov
*.mkv
*.webm

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# OS files
.DS_Store
Thumbs.db
